# =============================================================================
# SGO Beija Flor — Variáveis de ambiente (MODELO)
# Copie para `.env` e ajuste. NUNCA commite o .env (regra inegociável nº 10).
#
# ⚠️  ESTES SÃO VALORES DE DESENVOLVIMENTO (máquina local do programador).
#     Os SEGREDOS DE PRODUÇÃO (chaves reais, senha do banco de produção) ficam
#     SOMENTE no servidor (droplet) — nunca peça nem copie o .env de produção.
# =============================================================================

# --- Ambiente ---
NODE_ENV=development
APP_PORT=3100                      # porta interna do app (NÃO usar 3000/3001 do CEO)
TZ=America/Sao_Paulo

# --- Banco de dados (PostgreSQL dedicado do SGO) ---
# Em DEV o Postgres do SGO sobe pelo `docker compose up -d` na porta 5433.
POSTGRES_USER=sgo
POSTGRES_PASSWORD=troque-esta-senha-de-dev
POSTGRES_DB=sgo
POSTGRES_PORT_HOST=5433           # porta no host (dev). Em prod NÃO se publica porta.
# Para o app rodando no host (npm run dev):
DATABASE_URL=postgresql://sgo:troque-esta-senha-de-dev@localhost:5433/sgo?schema=public
# Para o app rodando DENTRO do Docker, use o host do serviço:
# DATABASE_URL=postgresql://sgo:troque-esta-senha-de-dev@sgo-db:5432/sgo?schema=public

# --- Autenticação (JWT) — gere strings aleatórias longas p/ o seu ambiente ---
JWT_ACCESS_SECRET=troque-por-uma-string-aleatoria-longa
JWT_REFRESH_SECRET=troque-por-outra-string-aleatoria-longa
JWT_ACCESS_TTL=8h
JWT_REFRESH_TTL=30d
BCRYPT_ROUNDS=12

# --- Claude API (modelo SEMPRE via env — regra inegociável nº 6) ---
# Opcional em DEV: sem a chave, os recursos de visão/IA ficam INERTES (o resto
# do sistema funciona normalmente). Não use a chave de produção localmente.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# --- Web Push / PWA (VAPID) — notificações no celular (v1.38.0) ---
# Opcional em DEV: sem as chaves o push fica INERTE (a Central de Notificações
# in-app continua funcionando). Gere um par PRÓPRIO com: node scripts/gen-vapid.mjs
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@exemplo.com

# --- Publicação ---
# Produção roda no droplet, atrás do Caddy (TLS automático). Em DEV isto é só
# informativo — o app sobe em http://localhost:3100.
APP_PUBLIC_URL=http://localhost:3100

# --- Backups (só produção; deixe em branco em DEV) ---
BACKUP_ENCRYPTION_PASSPHRASE=
BACKUP_MIRROR_DIR=

# --- Integração API RH (GBF RH) — Módulo 9 (opcional em DEV) ---
# Sem RH_API_KEY o botão de sincronizar apenas não traz dados; o resto funciona.
RH_API_BASE_URL=https://gbf-rh.replit.app
RH_API_KEY=
# Recepção de eventos do RH e webhook de férias (opcionais em DEV):
RH_INBOUND_TOKEN=
RH_WEBHOOK_FERIAS_URL=
SGO_WEBHOOK_TOKEN=
