# =============================================================================
# SGO Beija Flor — Variáveis de ambiente (MODELO)
# Copie para `.env` e ajuste. NUNCA commite o .env (regra inegociável nº 10).
# =============================================================================

# --- Ambiente ---
NODE_ENV=development
APP_PORT=3100                      # porta interna do app (NÃO usar 3000/3001 do CEO)
TZ=America/Sao_Paulo

# --- Banco de dados (PostgreSQL dedicado do SGO) ---
# Em DEV o Postgres do SGO é exposto em 5433 (5432 é do bjf_postgres do CEO).
POSTGRES_USER=sgo
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=sgo
POSTGRES_PORT_HOST=5433           # porta no host (dev). Em prod NÃO se publica porta.
# Para o app rodando no host (npm run dev):
DATABASE_URL=postgresql://sgo:troque-esta-senha@localhost:5433/sgo?schema=public
# Para o app rodando DENTRO do Docker, use o host do serviço:
# DATABASE_URL=postgresql://sgo:troque-esta-senha@sgo-db:5432/sgo?schema=public

# --- Autenticação (JWT) ---
JWT_ACCESS_SECRET=troque-por-uma-string-aleatoria-longa
JWT_REFRESH_SECRET=troque-por-outra-string-aleatoria-longa
JWT_ACCESS_TTL=8h
JWT_REFRESH_TTL=30d
BCRYPT_ROUNDS=12

# --- Claude API (modelo SEMPRE via env — regra inegociável nº 6) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# --- Firebase Cloud Messaging (push) ---
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# --- Publicação (Cloudflare Tunnel já existente) — definir quando publicar ---
# Domínio do SGO (subdomínio dedicado, isolado da plataforma do CEO):
APP_PUBLIC_URL=https://sgo.SEUDOMINIO.com.br
APP_PUBLIC_URL_HOMOLOG=https://sgo-homolog.SEUDOMINIO.com.br

# --- Backups 3-2-1 (Fase 0.4) ---
BACKUP_ENCRYPTION_PASSPHRASE=
# Destino externo (Backblaze B2 / S3) — preencher na configuração do backup
BACKUP_REMOTE_BUCKET=

# --- Integração API RH (GBF RH) — Módulo 9 ---
RH_API_BASE_URL=https://gbf-rh.replit.app
# Chave enviada no header x-api-key. NUNCA commitar — rotacionar se exposta.
RH_API_KEY=
