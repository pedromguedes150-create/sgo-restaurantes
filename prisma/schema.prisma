// SGO Beija Flor — Schema (Fase 1: Auth + Estrutura base)
// Base única; escopo por unidade (unit_id) aplicado SEMPRE no servidor.

generator client {
  provider = "prisma-client-js"
  // native = dev (Windows); linux-musl-openssl-3.0.x = produção (node:20-alpine)
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Perfis de acesso (ver docs/especificacao.md — Perfis)
enum Role {
  CEO // Diretoria — todas as unidades, leitura total + auditoria
  ADMIN // Configurações globais, cadastros, metas, POPs, importações
  SUPERVISOR // Unidades sob gestão — aprovações, encerramentos
  COORDINATOR // Sua(s) unidade(s) — acompanhamento, sem aprovação
  MANAGER // Gerente — operação diária, lançamentos
  FINANCE // Financeiro — sem acesso operacional; recebe notificações
}

/// Unidade (restaurante). Toda lógica diária usa a data operacional desta unidade.
model Unit {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique // sigla curta p/ exibição
  address   String?
  cnpj      String?
  /// Razão social correspondente na API do RH (para casar/sincronizar colaboradores)
  rhUnitName String?
  /// Fuso da unidade (exibição). Banco grava em UTC. Padrão America/Sao_Paulo.
  timezone  String   @default("America/Sao_Paulo")
  /// Hora de corte da data operacional (0-23). Padrão 04:00 (regra nº 4).
  cutoffHour Int     @default(4)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships   UnitMembership[]
  auditLogs     AuditLog[]
  taskTemplates TaskTemplate[]
  taskInstances TaskInstance[]
  wasteEntries  WasteEntry[]
  occurrences   Occurrence[]
  commandConfig       UnitCommandConfig?
  commandSequences    CommandSequence[]
  commandCounts       CommandCount[]
  commandDivergences  CommandDivergence[]
  commandReplacements CommandReplacement[]
  cancellations       Cancellation[]
  cancellationImports CancellationImport[]
  paymentRequests     PaymentRequest[]
  freelancerUnits     FreelancerUnit[]
  receivedNotes       ReceivedNote[]
  inventorySchedules  InventorySchedule[]
  collaboratorUnits   CollaboratorUnit[]
  vacations           Vacation[]
  scheduleEntries     ScheduleEntry[]
  popUnits            PopUnit[]
  sectors             Sector[]
  allocations         WorkforceAllocation[]
  workforceDaySnapshots WorkforceDaySnapshot[]
  shifts              Shift[]
  employeeSchedules   EmployeeSchedule[]
  schedulePlanOverrides SchedulePlanOverride[]
  scheduleActuals     ScheduleActual[]
  trainings           TrainingRecord[]
  communicationUnits      CommunicationUnit[]
  communicationRecipients CommunicationRecipient[]
  gasReceipts             GasReceipt[]
  oilCollections          OilCollection[]
  inventoryItems          InventoryItem[]
  inventoryMovements      InventoryMovement[]
  medicalCertificates     MedicalCertificate[]
  freelancerRates         FreelancerHourlyRate[]
  terminations            Termination[]

  @@map("units")
}

/// Usuário do sistema.
model User {
  id             String   @id @default(cuid())
  name           String
  /// CPF do usuário (só dígitos) — preenchido pelo próprio no Meu Perfil (16/07)
  cpf            String?
  email          String   @unique
  passwordHash   String
  role           Role
  active         Boolean  @default(true)
  /// Aceite do termo LGPD no 1º login (regra LGPD nº 1)
  termsAcceptedAt DateTime?
  termsVersion    String?
  lastLoginAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  memberships    UnitMembership[]
  refreshTokens  RefreshToken[]
  auditLogs      AuditLog[]
  completedTasks TaskInstance[] @relation("CompletedBy")
  assignedTasks  TaskInstance[] @relation("AssignedTo")
  wasteEntries   WasteEntry[]   @relation("WasteCreatedBy")
  reportedOccurrences Occurrence[] @relation("OccReportedBy")
  closedOccurrences   Occurrence[] @relation("OccClosedBy")
  commandCounts       CommandCount[]       @relation("CmdCountBy")
  divReported         CommandDivergence[]  @relation("CmdDivReportedBy")
  divResolved         CommandDivergence[]  @relation("CmdDivResolvedBy")
  commandReplacements CommandReplacement[] @relation("CmdReplBy")
  cancellationsJustified Cancellation[]       @relation("CancJustifiedBy")
  cancellationImports    CancellationImport[] @relation("CancImportedBy")
  paymentRequested PaymentRequest[]     @relation("PayRequestedBy")
  paymentApproved  PaymentRequest[]     @relation("PayApprovedBy")
  paymentPaid      PaymentRequest[]     @relation("PayPaidBy")
  delegationsFrom  ApprovalDelegation[] @relation("DelegFrom")
  delegationsTo    ApprovalDelegation[] @relation("DelegTo")
  receivedNotes    ReceivedNote[]       @relation("NoteCreatedBy")
  inventoryResponsible InventorySchedule[] @relation("InvResp")
  inventoryConfirmed   InventorySchedule[] @relation("InvConf")
  popReads             PopRead[]
  notifications        Notification[]
  scheduleActuals      ScheduleActual[] @relation("ScheduleActualBy")
  trainingsApplied     TrainingRecord[] @relation("TrainingBy")
  communicationsAuthored  Communication[]          @relation("CommAuthor")
  communicationRecipients CommunicationRecipient[] @relation("CommRecipient")
  gasReceipts             GasReceipt[]             @relation("GasReceiptBy")
  suppliersCreated        Supplier[]               @relation("SupplierBy")
  oilCollections          OilCollection[]          @relation("OilBy")
  inventoryItemsCreated   InventoryItem[]          @relation("InvItemBy")
  inventoryMovements      InventoryMovement[]      @relation("InvMoveBy")
  checklistModels         ChecklistModel[]         @relation("ChecklistModelBy")
  medicalCertificates     MedicalCertificate[]     @relation("CertBy")
  managerTasks            ManagerTask[]            @relation("MgrTasks")
  managerNotes            ManagerNote[]            @relation("MgrNotes")
  managerLeaves           ManagerLeave[]           @relation("MgrLeaves")
  managerWorkSchedule     ManagerWorkSchedule?     @relation("MgrWorkSchedule")
  terminationsRequested   Termination[]            @relation("TermReqBy")
  terminationsApproved    Termination[]            @relation("TermApprBy")

  @@map("users")
}

/// Vínculo usuário↔unidade (multi-unidade respeitado). CEO/ADMIN ignoram isto (veem tudo).
model UnitMembership {
  id        String   @id @default(cuid())
  userId    String
  unitId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([userId, unitId])
  @@index([unitId])
  @@map("unit_memberships")
}

/// Refresh tokens (rotação). Guardamos apenas o hash do token.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// Log de Auditoria — imutável (sem update/delete pela aplicação). Módulo 12.
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  unitId    String?
  action    String // ex: LOGIN, LOGOUT, CREATE, UPDATE, DELETE, APPROVE...
  module    String? // ex: AUTH, USERS, OCCURRENCES...
  entity    String? // tabela/entidade afetada
  entityId  String?
  /// Detalhes/diff e contexto (inclui acessos a dados sensíveis — LGPD nº 6)
  metadata  Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  unit Unit? @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([unitId])
  @@index([module])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Módulo associado a uma tarefa — permite o atalho "Realizar" abrir o módulo certo.
enum TaskModule {
  GENERAL // tarefa avulsa / operacional
  WASTE // Desperdícios (Módulo 2)
  COMMANDS // Comandas (Módulo 3)
  CANCELLATIONS // Cancelamento de cupons (Módulo 4)
  INVENTORY // Inventário (Módulo 5)
  OCCURRENCES // Ocorrências (Módulo 6)
}

enum TaskStatus {
  PENDING // a fazer
  DONE // concluída (no prazo)
  MISSED // "Não realizada" (passou da hora) — penaliza a meta
  LATE // concluída FORA do prazo — neutro (não conta na meta)
}

/// Escopo do checklist: da unidade (qualquer gerente conclui) ou individual (1 por gerente/dia).
enum ChecklistScope {
  UNIT
  MANAGER
}

/// Marcação de um item do checklist.
enum ItemStatus {
  OK // De acordo
  EM_CORRECAO // Em correção
  A_CORRIGIR // A corrigir (gera ocorrência)
  NAO_SE_APLICA // Não se aplica (neutro — não gera ocorrência)
}

/// Modelo (catálogo) de tarefa/checklist configurável por unidade (Módulo 1 / Config).
model TaskTemplate {
  id              String     @id @default(cuid())
  unitId          String
  name            String
  description     String?
  /// Horário limite "HH:mm" (dentro do dia operacional). NULL = sem horário (até o fim do dia).
  limitTime       String?
  /// Peso na meta (Módulo 11). Só conta se entersMeta = true.
  weight          Int        @default(1)
  module          TaskModule @default(GENERAL)
  scope           ChecklistScope @default(UNIT)
  /// Liga cópias do mesmo checklist em várias unidades (replicação).
  groupKey        String?
  /// Exige evidência fotográfica ao concluir (conceito transversal nº 6)
  requiresEvidence Boolean   @default(false)
  /// "Entra na Meta" (Módulo 11)
  entersMeta      Boolean    @default(true)
  /// Programação: data de início 'YYYY-MM-DD' (NULL = vale desde sempre)
  startDate       String?
  /// Programação: data de encerramento 'YYYY-MM-DD' (NULL = sem fim)
  endDate         String?
  active          Boolean    @default(true)
  order           Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  unit      Unit           @relation(fields: [unitId], references: [id], onDelete: Cascade)
  instances TaskInstance[]
  items     ChecklistItem[]

  @@index([unitId, active])
  @@map("task_templates")
}

/// Item/etapa de um checklist (verificação com marcação 🟢🟡🔴).
model ChecklistItem {
  id           String  @id @default(cuid())
  templateId   String
  section      String? // agrupador opcional (ex.: "Cozinha", "Salão")
  text         String
  requiresPhoto Boolean @default(false)
  order        Int     @default(0)
  /// Checagem por IA (visão): compara a foto com o padrão esperado (modo consultivo).
  aiCheck      Boolean @default(false)
  /// Descrição do padrão esperado (o que a IA deve verificar na foto).
  standardDescription String?
  /// Imagem de referência do padrão (opcional) — caminho no volume de uploads.
  referenceImagePath  String?

  template TaskTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("checklist_items")
}

/// Instância diária de uma tarefa, amarrada à DATA OPERACIONAL (regra nº 4).
model TaskInstance {
  id              String     @id @default(cuid())
  templateId      String
  unitId          String
  /// Data operacional 'YYYY-MM-DD' à qual a tarefa pertence
  operationalDate String
  status          TaskStatus @default(PENDING)
  /// Limite efetivo (UTC) calculado a partir do dia operacional + limitTime
  dueAt           DateTime
  /// Para checklists individuais (scope MANAGER): o gerente dono desta instância.
  assignedToId    String?
  completedById   String?
  completedAt     DateTime?
  /// Caminho da evidência fotográfica no volume de uploads (se exigida) — legado/foto principal
  evidencePath    String?
  /// Rascunho de preenchimento (auto-salvamento contra interrupções)
  draft           Json?
  createdAt       DateTime   @default(now())

  template      TaskTemplate        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  unit          Unit                @relation(fields: [unitId], references: [id], onDelete: Cascade)
  completedBy   User?               @relation("CompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  assignedTo    User?               @relation("AssignedTo", fields: [assignedToId], references: [id], onDelete: Cascade)
  itemResponses TaskItemResponse[]
  photos        TaskPhoto[]

  // Uma tarefa por modelo/dia (UNIT) ou por modelo/dia/gerente (MANAGER).
  @@unique([templateId, operationalDate, assignedToId])
  @@index([unitId, operationalDate])
  @@index([status])
  @@index([assignedToId, operationalDate])
  @@map("task_instances")
}

/// Resposta de um item do checklist (desacoplada do item p/ preservar histórico).
model TaskItemResponse {
  id         String     @id @default(cuid())
  instanceId String
  itemId     String // referência ao ChecklistItem (sem FK; histórico sobrevive a edições)
  itemText   String // snapshot do texto no momento da resposta
  status     ItemStatus
  note       String?
  createdAt  DateTime   @default(now())

  instance TaskInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@unique([instanceId, itemId])
  @@map("task_item_responses")
}

/// Foto anexada a uma execução de checklist (até 5 por instância). Arquivo no volume de uploads.
model TaskPhoto {
  id         String   @id @default(cuid())
  instanceId String
  path       String
  itemId     String?
  caption    String?
  createdAt  DateTime @default(now())

  instance TaskInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([instanceId])
  @@map("task_photos")
}

/// Categoria de desperdício (Módulo 2). Global e expansível sem quebrar histórico.
model WasteCategory {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  /// Unidade de medida: 'kg' (padrão) ou 'un' (ex.: lanchonete — 16/07)
  measure   String   @default("kg")
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  items WasteEntryItem[]

  @@map("waste_categories")
}

/// Lançamento de desperdício — UM por unidade por dia operacional (Módulo 2).
model WasteEntry {
  id              String   @id @default(cuid())
  unitId          String
  operationalDate String
  observation     String?
  /// Foto do visor da balança, quando a tarefa exigir evidência
  evidencePath    String?
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  unit      Unit             @relation(fields: [unitId], references: [id], onDelete: Cascade)
  createdBy User?            @relation("WasteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items     WasteEntryItem[]

  // Regra: 1 lançamento por unidade/dia operacional (conflito offline aplicado)
  @@unique([unitId, operationalDate])
  @@index([unitId, operationalDate])
  @@map("waste_entries")
}

/// Peso (KG) por categoria dentro de um lançamento.
model WasteEntryItem {
  id         String  @id @default(cuid())
  entryId    String
  categoryId String
  /// Total na unidade da categoria (kg ou unidades)
  kg         Decimal @db.Decimal(10, 3)
  /// Sub-itens (categorias em 'un', ex. lanchonete): [{ name, qty }] — soma = kg
  subItems   Json?

  entry    WasteEntry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  category WasteCategory @relation(fields: [categoryId], references: [id])

  @@unique([entryId, categoryId])
  @@index([categoryId])
  @@map("waste_entry_items")
}

/// Gravidade da ocorrência (🟢🟡🔴⚫) — Módulo 6.
enum OccurrenceGravity {
  LOW // 🟢
  MEDIUM // 🟡
  HIGH // 🔴 → alerta imediato ao Supervisor
  CRITICAL // ⚫ → Supervisor + CEO + destaque no consolidado
}

enum OccurrenceStatus {
  OPEN // Aberta
  IN_PROGRESS // Em andamento
  CLOSED // Encerrada (registro imutável)
}

/// Tipo de ocorrência (configurável/expansível).
model OccurrenceType {
  id         String                @id @default(cuid())
  code       String                @unique
  name       String
  order      Int                   @default(0)
  active     Boolean               @default(true)
  /// Tipo de manutenção → ocorrências aparecem na sub-aba Manutenção.
  isMaintenance Boolean            @default(false)
  /// Tipo de TI → ocorrências aparecem na sub-aba TI (futura API de gestão de TI).
  isIT          Boolean            @default(false)
  categories OccurrenceCategory[]
  occurrences Occurrence[]

  @@map("occurrence_types")
}

/// Categoria dependente do tipo (configurável/expansível).
model OccurrenceCategory {
  id     String @id @default(cuid())
  typeId String
  name   String
  order  Int    @default(0)
  active Boolean @default(true)

  type        OccurrenceType @relation(fields: [typeId], references: [id], onDelete: Cascade)
  occurrences Occurrence[]

  @@index([typeId])
  @@map("occurrence_categories")
}

/// Ocorrência (Módulo 6). Nº sequencial por unidade; encerramento imutável.
model Occurrence {
  id              String           @id @default(cuid())
  unitId          String
  /// Nº sequencial por unidade (exibição: #unidade-000123)
  number          Int
  occurredAt      DateTime         @default(now())
  operationalDate String
  reportedById    String?
  typeId          String?
  categoryId      String?
  /// snapshots para preservar histórico mesmo se tipo/categoria mudarem
  typeName        String
  categoryName    String
  gravity         OccurrenceGravity
  customerName    String?
  description     String
  status          OccurrenceStatus @default(OPEN)
  /// reincidência: mesmo tipo+categoria na mesma unidade em < 30 dias
  isRecurrence    Boolean          @default(false)
  /// Item do checklist que gerou a ocorrência (16/07): enquanto ela estiver
  /// aberta, o item aparece SINALIZADO nos checklists seguintes (sem recriar).
  sourceTaskItemId String?
  // Encerramento (somente Supervisor/Admin)
  closedById          String?
  closedAt            DateTime?
  closureJustification String?
  correctiveAction     String?
  reviewDate           DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  unit        Unit                 @relation(fields: [unitId], references: [id], onDelete: Cascade)
  reportedBy  User?                @relation("OccReportedBy", fields: [reportedById], references: [id], onDelete: SetNull)
  closedBy    User?                @relation("OccClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  type        OccurrenceType?      @relation(fields: [typeId], references: [id], onDelete: SetNull)
  category    OccurrenceCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  attachments OccurrenceAttachment[]
  updates     OccurrenceUpdate[]

  @@unique([unitId, number])
  @@index([unitId, status])
  @@index([unitId, operationalDate])
  @@index([sourceTaskItemId])
  @@index([gravity])
  @@map("occurrences")
}

/// Anexo (foto/vídeo) de uma ocorrência. Acesso a anexos sensíveis é auditado (LGPD).
/// Fase/andamento da ocorrência (16/07): registros de progresso até o encerramento.
model OccurrenceUpdate {
  id           String     @id @default(cuid())
  occurrenceId String
  text         String
  authorId     String?
  authorName   String
  createdAt    DateTime   @default(now())

  occurrence Occurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)

  @@index([occurrenceId, createdAt])
  @@map("occurrence_updates")
}

model OccurrenceAttachment {
  id           String   @id @default(cuid())
  occurrenceId String
  path         String
  mimeType     String
  createdAt    DateTime @default(now())

  occurrence Occurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)

  @@index([occurrenceId])
  @@map("occurrence_attachments")
}

/// Ciclo de vida de uma divergência de comanda (Módulo 3).
enum DivergenceStatus {
  OPEN // 🔴 Aberta
  INVESTIGATING // 🟡 Em apuração
  CLOSED // 🟢 Encerrada
}

enum DivergenceOutcome {
  RECOVERED // recuperada → volta à sequência ativa
  LOST // perdida → baixa definitiva (sai da sequência ativa)
}

/// Faixa(s) de numeração de comandas por unidade (pode haver várias).
model CommandSequence {
  id         String   @id @default(cuid())
  unitId     String
  name       String   @default("Sequência")
  rangeStart Int
  rangeEnd   Int
  active     Boolean  @default(true)
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([unitId])
  @@map("command_sequences")
}

/// (Legado) Sequência única por unidade — substituída por CommandSequence.
model UnitCommandConfig {
  id         String   @id @default(cuid())
  unitId     String   @unique
  rangeStart Int
  rangeEnd   Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@map("unit_command_configs")
}

/// Registro diário da contagem de comandas (Módulo 3).
model CommandCount {
  id              String   @id @default(cuid())
  unitId          String
  operationalDate String
  allPresent      Boolean  @default(false)
  absentCount     Int      @default(0)
  createdById     String?
  createdAt       DateTime @default(now())

  unit      Unit  @relation(fields: [unitId], references: [id], onDelete: Cascade)
  createdBy User? @relation("CmdCountBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([unitId, operationalDate])
  @@index([unitId, operationalDate])
  @@map("command_counts")
}

/// Divergência (comanda ausente) e seu ciclo de vida.
model CommandDivergence {
  id           String             @id @default(cuid())
  unitId       String
  number       Int
  status       DivergenceStatus   @default(OPEN)
  outcome      DivergenceOutcome?
  observation  String?
  createdById  String?
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  unit     Unit  @relation(fields: [unitId], references: [id], onDelete: Cascade)
  reporter User? @relation("CmdDivReportedBy", fields: [createdById], references: [id], onDelete: SetNull)
  resolver User? @relation("CmdDivResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([unitId, status])
  @@index([unitId, number])
  @@map("command_divergences")
}

/// Reposição de comandas registrada pelo Admin (entra na sequência ativa).
model CommandReplacement {
  id          String   @id @default(cuid())
  unitId      String
  number      Int
  note        String?
  createdById String?
  createdAt   DateTime @default(now())

  unit      Unit  @relation(fields: [unitId], references: [id], onDelete: Cascade)
  createdBy User? @relation("CmdReplBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([unitId, number])
  @@map("command_replacements")
}

enum CancellationStatus {
  PENDING // aguardando justificativa
  JUSTIFIED // justificado
}

/// Motivo de cancelamento (configurável — Módulo 4).
model CancellationReason {
  id            String         @id @default(cuid())
  name          String
  order         Int            @default(0)
  active        Boolean        @default(true)
  cancellations Cancellation[]

  @@map("cancellation_reasons")
}

/// Importação de relatório do Teknisa (CSV) — Módulo 4.
model CancellationImport {
  id              String   @id @default(cuid())
  unitId          String
  operationalDate String
  fileName        String
  rowCount        Int      @default(0)
  importedById    String?
  createdAt       DateTime @default(now())

  unit          Unit           @relation(fields: [unitId], references: [id], onDelete: Cascade)
  importedBy    User?          @relation("CancImportedBy", fields: [importedById], references: [id], onDelete: SetNull)
  cancellations Cancellation[]

  @@index([unitId, operationalDate])
  @@map("cancellation_imports")
}

/// Cancelamento de cupom fiscal → pendência de justificativa do gerente.
model Cancellation {
  id                String             @id @default(cuid())
  unitId            String
  operationalDate   String
  importId          String?
  couponNumber      String
  cashOperator      String?
  value             Decimal            @db.Decimal(10, 2)
  status            CancellationStatus @default(PENDING)
  reasonId          String?
  justificationNote String?
  justifiedById     String?
  justifiedAt       DateTime?
  createdAt         DateTime           @default(now())

  unit        Unit                @relation(fields: [unitId], references: [id], onDelete: Cascade)
  import      CancellationImport? @relation(fields: [importId], references: [id], onDelete: SetNull)
  reason      CancellationReason? @relation(fields: [reasonId], references: [id], onDelete: SetNull)
  justifiedBy User?               @relation("CancJustifiedBy", fields: [justifiedById], references: [id], onDelete: SetNull)

  @@index([unitId, status])
  @@index([unitId, operationalDate])
  @@map("cancellations")
}

enum PaymentType {
  FREELANCER // 7.1
  OVERTIME // 7.2 (horas extras)
  MISC // 7.3 (pagamento avulso)
}

enum PaymentStatus {
  PENDING // Pendente
  APPROVED // Aprovada
  REJECTED // Rejeitada
  PAID // Paga
}

/// Cadastro de freelancer (multi-unidade, valor padrão) — Módulo 7.1.
/// Tipo de dia para o valor/hora do freelancer.
enum DayType {
  WEEKDAY // dia útil (seg-sex, não feriado)
  WEEKEND // sábado/domingo
  HOLIDAY // feriado (cadastro `Holiday`)
}

/// Valor da hora do freelancer por unidade × tipo de dia (Módulo 7 / v1.2).
model FreelancerHourlyRate {
  id      String  @id @default(cuid())
  unitId  String
  dayType DayType
  value   Decimal @db.Decimal(10, 2)

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([unitId, dayType])
  @@map("freelancer_hourly_rates")
}

/// Feriados (para o valor/hora do freelancer). Global; data única yyyy-mm-dd.
model Holiday {
  id        String   @id @default(cuid())
  date      String   @unique
  name      String
  createdAt DateTime @default(now())

  @@map("holidays")
}

// ───────────────────────── Área do Gerente (Módulo 20 / v1.3) ─────────────────────────
enum ManagerLeaveKind {
  FOLGA
  FERIAS
}

/// Tarefas pessoais do gerente (agenda simples). Lembrete quando `dueAt` chega.
model ManagerTask {
  id         String    @id @default(cuid())
  userId     String
  title      String
  notes      String?
  dueAt      DateTime?
  done       Boolean   @default(false)
  doneAt     DateTime?
  notifiedAt DateTime? // lembrete já enviado (evita duplicar)
  createdAt  DateTime  @default(now())

  user User @relation("MgrTasks", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("manager_tasks")
}

/// Bloco de notas livre do gerente.
model ManagerNote {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation("MgrNotes", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("manager_notes")
}

/// Folgas/férias do gerente (ele não bate ponto). Nesses dias os checklists somem da visão dele.
model ManagerLeave {
  id        String           @id @default(cuid())
  userId    String
  kind      ManagerLeaveKind @default(FOLGA)
  startDate String // yyyy-mm-dd
  endDate   String
  note      String?
  createdAt DateTime         @default(now())

  user User @relation("MgrLeaves", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("manager_leaves")
}

/// Local de higiene (banheiro) por unidade — QR aponta para a página pública (20/07).
model HygieneLocation {
  id        String   @id @default(cuid())
  unitId    String
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([unitId, active])
  @@map("hygiene_locations")
}

/// Solicitação de higienização (pública, via QR do banheiro) — centraliza o antigo Forms→WhatsApp.
model HygieneRequest {
  id             String    @id @default(cuid())
  unitId         String
  locationId     String?
  locationName   String
  issue          String?
  rating         Int?
  comment        String?
  status         String    @default("OPEN")
  resolvedById   String?
  resolvedByName String?
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([unitId, createdAt])
  @@index([unitId, status])
  @@map("hygiene_requests")
}

/// Análise de "Comandas em Aberto" (Teknisa) — antifraude das 2 comandas (20/07).
/// Supervisor/Admin sobe o relatório; guardamos as suspeitas (aberta + valor + data < hoje).
model OpenCommandAnalysis {
  id              String   @id @default(cuid())
  unitId          String
  createdById     String
  createdByName   String
  cutDate         String // yyyy-mm-dd usado como corte
  fileName        String?
  totalCommands   Int
  suspectCount    Int
  suspectValue    Decimal  @db.Decimal(12, 2)
  suspects        Json // [{ number, openedAt, value, daysOpen, items:[{name,qty,value}] }]
  createdAt       DateTime @default(now())

  @@index([unitId, createdAt])
  @@map("open_command_analyses")
}

/// Horário de trabalho do gerente (padrão semanal recorrente) — base do calendário
/// consolidado de gerência por unidade (20/07). weekdays = dias trabalhados (0=dom..6=sáb).
model ManagerWorkSchedule {
  id               String    @id @default(cuid())
  userId           String    @unique
  weekdays         Json      @default("[]")
  startTime        String? // "HH:mm"
  endTime          String? // "HH:mm"
  note             String?
  /// Última vez que o supervisor foi avisado da falta de folga (guarda anti-spam do alerta 7d).
  lastFolgaAlertAt DateTime?
  updatedAt        DateTime  @updatedAt

  user User @relation("MgrWorkSchedule", fields: [userId], references: [id], onDelete: Cascade)

  @@map("manager_work_schedules")
}

model Freelancer {
  id           String           @id @default(cuid())
  name         String
  defaultValue Decimal          @db.Decimal(10, 2)
  /// Chave PIX para pagamento (obrigatória no cadastro) — Módulo 7.
  pixKey       String?
  active       Boolean          @default(true)
  createdAt    DateTime         @default(now())
  units        FreelancerUnit[]
  requests     PaymentRequest[]
  sectorRates  FreelancerSectorRate[]

  @@map("freelancers")
}

model FreelancerUnit {
  id           String @id @default(cuid())
  freelancerId String
  unitId       String

  freelancer Freelancer @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  unit       Unit       @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([freelancerId, unitId])
  @@map("freelancer_units")
}

/// Cobertura temporária de setor (16/07): valor por DIA de trabalho por setor
/// cadastrado no freelancer (o valor varia por setor). Setor por NOME (vale em
/// qualquer unidade).
model FreelancerSectorRate {
  id           String  @id @default(cuid())
  freelancerId String
  sectorName   String
  dayValue     Decimal @db.Decimal(10, 2)

  freelancer Freelancer @relation(fields: [freelancerId], references: [id], onDelete: Cascade)

  @@unique([freelancerId, sectorName])
  @@map("freelancer_sector_rates")
}

/// Tipo de pagamento avulso + aprovador por tipo — Módulo 7.3.
model MiscPaymentType {
  id           String           @id @default(cuid())
  name         String
  approverRole Role             @default(SUPERVISOR)
  active       Boolean          @default(true)
  order        Int              @default(0)
  requests     PaymentRequest[]

  @@map("misc_payment_types")
}

/// Delegação de aprovação por período (NOVO) — Módulo 7.
model ApprovalDelegation {
  id          String   @id @default(cuid())
  fromUserId  String
  toUserId    String
  startsAt    DateTime
  endsAt      DateTime
  createdById String?
  createdAt   DateTime @default(now())

  fromUser User @relation("DelegFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("DelegTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([toUserId])
  @@index([fromUserId])
  @@map("approval_delegations")
}

/// Solicitação de pagamento (freelancer / hora extra / avulso) — Módulo 7.
model PaymentRequest {
  id            String        @id @default(cuid())
  type          PaymentType
  unitId        String
  requestedById String?
  status        PaymentStatus @default(PENDING)
  /// Perfil que deve aprovar (SUPERVISOR p/ freela/HE; do tipo p/ avulso)
  approverRole  Role          @default(SUPERVISOR)
  amount        Decimal       @db.Decimal(10, 2)
  /// Valor-padrão do freelancer no momento do lançamento (snapshot) — base da divergência
  standardValue Decimal?      @db.Decimal(10, 2)
  /// true quando o valor lançado diverge do padrão cadastrado (alerta, não bloqueia)
  divergent     Boolean       @default(false)
  description   String?

  // Freelancer
  freelancerId String?
  workDate     DateTime?
  shift        String?
  hours        Float?
  /// Janela de trabalho do freelancer (HH:MM) — usada na alocação/Mapa do dia
  workStartTime String?
  workEndTime   String?
  /// Setor onde o freelancer foi alocado no Mapa do dia (Módulo 9.3)
  workSectorId  String?
  /// Cobertura temporária de setor (16/07): nome do setor coberto — valor por DIA
  coverageSector String?
  /// Vale transporte somado ao valor do freelancer (opcional)
  transportValue Decimal? @db.Decimal(10, 2)

  // Hora extra
  collaboratorName String?
  reason           String?

  // Avulso
  miscTypeId     String?
  beneficiary    String?
  attachmentPath String?
  /// Vínculo opcional ao cadastro de fornecedores (lista compartilhada)
  supplierId     String?

  // Data efetiva do lançamento (item 4, 07/07): null = createdAt. Editável por
  // Admin/Supervisor quando o gerente esqueceu de lançar — edição penaliza a meta.
  entryDate        DateTime?
  dateEdited       Boolean   @default(false)
  dateEditedByName String?

  // Workflow
  approvedById    String?
  approvedAt      DateTime?
  rejectionReason String?
  paidById        String?
  paidAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unit        Unit             @relation(fields: [unitId], references: [id], onDelete: Cascade)
  requestedBy User?            @relation("PayRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  approvedBy  User?            @relation("PayApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  paidBy      User?            @relation("PayPaidBy", fields: [paidById], references: [id], onDelete: SetNull)
  freelancer  Freelancer?      @relation(fields: [freelancerId], references: [id], onDelete: SetNull)
  miscType    MiscPaymentType? @relation(fields: [miscTypeId], references: [id], onDelete: SetNull)
  supplier    Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  workSector  Sector?          @relation("FreelancerSector", fields: [workSectorId], references: [id], onDelete: SetNull)

  @@index([unitId, status])
  @@index([status])
  @@index([requestedById])
  @@map("payment_requests")
}

enum NoteStatus {
  RECEIVED // Recebida
  PAID // Paga
  PROBLEM // Com problema
  RETURNED // Devolvida (nota errada / devolução ao fornecedor)
}

enum NoteSource {
  QRCODE // QR/chave 44 dígitos (NFC-e/NF-e)
  PHOTO // foto + IA (fallback)
  MANUAL // digitação manual
}

/// Nota fiscal recebida (Módulo 8). Confirmação obrigatória antes de salvar.
model ReceivedNote {
  id           String     @id @default(cuid())
  unitId       String
  source       NoteSource @default(MANUAL)
  accessKey    String? // chave de acesso (44 dígitos)
  supplierName String
  supplierCnpj String?
  /// Vínculo opcional ao cadastro de fornecedores (lista compartilhada)
  supplierId   String?
  number       String?
  issueDate    DateTime?
  dueDate      DateTime?
  totalValue   Decimal    @db.Decimal(12, 2)
  productType  String?
  observation  String?
  imagePath    String?
  status       NoteStatus @default(RECEIVED)
  problemNote  String?
  /// Data efetiva do lançamento (item 4): null = createdAt; edição penaliza a meta.
  entryDate        DateTime?
  dateEdited       Boolean   @default(false)
  dateEditedByName String?
  /// Nota lançada pela supervisão (gerente esqueceu) — desconta na meta (16/07)
  supervisorLaunched Boolean @default(false)
  createdById  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  unit      Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("NoteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  supplier  Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([unitId, status])
  @@index([accessKey])
  @@map("received_notes")
}

enum InventoryStatus {
  PENDING // agendado
  DONE // realizado
  MISSED // não realizado
}

/// Inventário (Módulo 5) — registro de EXECUÇÃO (feito/não feito).
model InventorySchedule {
  id            String          @id @default(cuid())
  unitId        String
  categoryName  String
  scheduledDate String // data operacional 'YYYY-MM-DD'
  responsibleId String?
  status        InventoryStatus @default(PENDING)
  confirmedById String?
  confirmedAt   DateTime?
  observation   String?
  createdAt     DateTime        @default(now())

  unit        Unit  @relation(fields: [unitId], references: [id], onDelete: Cascade)
  responsible User? @relation("InvResp", fields: [responsibleId], references: [id], onDelete: SetNull)
  confirmedBy User? @relation("InvConf", fields: [confirmedById], references: [id], onDelete: SetNull)

  @@index([unitId, scheduledDate])
  @@map("inventory_schedules")
}

enum CollaboratorSource {
  RH // via API do RH
  MANUAL // cadastro manual (fallback do Admin)
}

/// Colaborador (Módulo 9). Fonte primária: API RH; fallback manual.
model Collaborator {
  id        String             @id @default(cuid())
  name      String
  jobTitle  String?
  active    Boolean            @default(true)
  source    CollaboratorSource @default(MANUAL)
  externalId String? // id no RH
  /// CPF (só dígitos, do RH) — casa os eventos de desligamento da integração
  cpf       String?
  /// Data de admissão (do RH, 'YYYY-MM-DD') — base do tempo de empresa
  hireDate  String?
  createdAt DateTime           @default(now())

  units     CollaboratorUnit[]
  vacations Vacation[]
  schedule  ScheduleEntry[]
  allocations WorkforceAllocation[]
  employeeSchedules EmployeeSchedule[]
  planOverrides     SchedulePlanOverride[]
  scheduleActuals   ScheduleActual[]
  trainings         TrainingRecord[]
  medicalCertificates MedicalCertificate[]
  terminations      Termination[]

  @@index([cpf])
  @@map("collaborators")
}

// ===== Pessoas 9.x — Período de experiência (≤90 dias) =======================
enum ProbationStatus {
  PENDING
  APPROVED
  REJECTED
}

// Avaliação do período de experiência de um colaborador (decisão do gestor).
// Denormalizado (collaboratorId/unitId como string) no padrão snapshot.
model ProbationReview {
  id               String          @id @default(cuid())
  collaboratorId   String          @unique
  collaboratorName String
  unitId           String
  status           ProbationStatus @default(PENDING)
  notes            String?
  decidedById      String?
  decidedByName    String?
  decidedAt        DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([unitId])
  @@map("probation_reviews")
}

// ===== Pessoas 9.x — Avaliação do colaborador (item 13, Onda 3) ==============

/// Observação do dia a dia sobre um colaborador (não altera o cadastro do RH).
/// Denormalizado (snapshot de nomes) no padrão do módulo Pessoas.
model CollaboratorObservation {
  id               String   @id @default(cuid())
  collaboratorId   String
  collaboratorName String
  unitId           String
  text             String
  authorId         String
  authorName       String
  createdAt        DateTime @default(now())

  @@index([collaboratorId])
  @@index([unitId])
  @@map("collaborator_observations")
}

/// Avaliação mensal do colaborador (1 por colaborador/mês). Critérios 1–5.
model CollaboratorEvaluation {
  id               String   @id @default(cuid())
  collaboratorId   String
  collaboratorName String
  unitId           String
  yearMonth        String // 'YYYY-MM'
  punctuality      Int // 1–5
  performance      Int // 1–5
  teamwork         Int // 1–5
  presentation     Int // 1–5 (apresentação/higiene)
  comments         String?
  evaluatorId      String
  evaluatorName    String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([collaboratorId, yearMonth])
  @@index([unitId, yearMonth])
  @@map("collaborator_evaluations")
}

// ===== Pessoas 9.x — Mudança de função/setor → RH (item 12, Onda 3) ==========
enum RoleChangeKind {
  FUNCTION // mudança de função/cargo (efetivada pelo RH; aqui é o registro/solicitação)
  SECTOR // mudança de setor no Mapa de Funções (efetiva no SGO)
}

/// Simulação de alocação para um DIA FUTURO do Mapa (16/07): rascunho que o
/// gerente monta na projeção e salva; não altera o quadro padrão.
model WorkforceSimulation {
  id            String   @id @default(cuid())
  unitId        String
  date          String // YYYY-MM-DD (dia futuro)
  /// [{ collaboratorId, name, sectorId, sectorName }]
  assignments   Json
  note          String?
  createdById   String
  createdByName String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([unitId, date])
  @@map("workforce_simulations")
}

/// Registro consolidado de mudanças de função/setor para informar o RH
/// (futura API do RH pluga aqui). Denormalizado no padrão snapshot.
model RoleChange {
  id               String         @id @default(cuid())
  collaboratorId   String
  collaboratorName String
  unitId           String
  kind             RoleChangeKind
  fromValue        String?
  toValue          String
  requestedById    String
  requestedByName  String
  createdAt        DateTime       @default(now())

  @@index([unitId, createdAt])
  @@index([collaboratorId])
  @@map("role_changes")
}

// ===== Pessoas 9.x — Comissões/Mobilidade (item 14, Onda 3) ==================
enum PayoutType {
  COMMISSION // comissão (valores do Teknisa, lançados manualmente)
  MOBILITY // mobilidade (manual)
}

/// Lançamento de comissão/mobilidade por colaborador/unidade/mês.
/// Vários lançamentos por mês são permitidos (ajustes); dashboards somam.
model CollaboratorPayout {
  id               String     @id @default(cuid())
  collaboratorId   String
  collaboratorName String
  unitId           String
  type             PayoutType
  yearMonth        String // 'YYYY-MM'
  amount           Decimal    @db.Decimal(10, 2)
  note             String?
  createdById      String
  createdByName    String
  createdAt        DateTime   @default(now())

  @@index([unitId, yearMonth])
  @@index([collaboratorId])
  @@map("collaborator_payouts")
}

// ===== Escala — Trocas → RH (item 15, Onda 3) ================================

/// Registro de troca de escala para informar o RH (futura API pluga aqui).
/// A troca pode ser: mesmo colaborador mudando de dia (B vazio), dois
/// colaboradores trocando um dia (dateB vazio) ou troca completa (tudo).
model ScheduleChange {
  id                String   @id @default(cuid())
  unitId            String
  collaboratorAId   String
  collaboratorAName String
  dateA             String // 'YYYY-MM-DD' (dia original de A)
  collaboratorBId   String?
  collaboratorBName String?
  dateB             String? // 'YYYY-MM-DD' (novo dia / dia de B)
  reason            String?
  createdById       String
  createdByName     String
  createdAt         DateTime @default(now())

  @@index([unitId, createdAt])
  @@map("schedule_changes")
}

// ===== Módulo 16 — Gestão de Troco (Onda 4) ==================================

/// Sessão de caixa em CADEIA: o fechamento de um caixa é a abertura esperada do
/// próximo (mesmo entre dias — o troco pernoita). Abertura digitada ≠ fechamento
/// anterior → divergência (alerta). closingAmount null = caixa aberto.
model CashSession {
  id              String    @id @default(cuid())
  unitId          String
  operationalDate String // 'YYYY-MM-DD' (dia operacional da unidade)
  seq             Int // ordem no dia (1º, 2º… caixa)
  openingAmount   Decimal   @db.Decimal(10, 2)
  expectedOpening Decimal?  @db.Decimal(10, 2) // fechamento do caixa anterior (null = 1º da unidade)
  divergence      Decimal?  @db.Decimal(10, 2) // abertura − esperado (≠0 alerta)
  closingAmount   Decimal?  @db.Decimal(10, 2)
  note            String?
  openedById      String
  openedByName    String
  openedAt        DateTime  @default(now())
  closedById      String?
  closedByName    String?
  closedAt        DateTime?

  @@unique([unitId, operationalDate, seq])
  @@index([unitId, operationalDate])
  @@map("cash_sessions")
}

// ===== Módulo 18 v2 — Troco como COFRE (16/07, foto do Pedro) ================
enum CashMovementType {
  COUNT // conferência/posição completa por denominação (substitui o saldo)
  REFILL // reposição de balde: sai miúdo do cofre, entram notas grandes do balde
  OFFICE_SWAP // troca com o escritório: saem notas grandes, entram moedas/miúdos
  WITHDRAWAL // retirada p/ pagamento (PROIBIDA — registra, avisa supervisão)
  ADJUST // ajuste manual (supervisão)
}

/// Cofre de troco da unidade (1 por unidade). Saldo POR DENOMINAÇÃO em R$:
/// { "200": 0, "100": 0, …, "0.05": 60, "outros": 250 } — como na folha do gerente.
model CashVault {
  id        String   @id @default(cuid())
  unitId    String   @unique
  balances  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cash_vaults")
}

/// Balde de troco de um caixa físico — valor-alvo pré-fixado pelo supervisor.
model CashBucket {
  id          String  @id @default(cuid())
  unitId      String
  name        String // ex.: "Caixa 1"
  targetValue Decimal @db.Decimal(10, 2)
  active      Boolean @default(true)
  createdAt   DateTime @default(now())

  @@index([unitId, active])
  @@map("cash_buckets")
}

/// Movimento do cofre — deltas por denominação em R$ (positivo entra, negativo sai).
model CashVaultMovement {
  id            String           @id @default(cuid())
  unitId        String
  type          CashMovementType
  bucketId      String?
  bucketName    String?
  deltas        Json
  totalIn       Decimal          @db.Decimal(12, 2)
  totalOut      Decimal          @db.Decimal(12, 2)
  note          String?
  createdById   String
  createdByName String
  createdAt     DateTime         @default(now())

  @@index([unitId, createdAt])
  @@index([unitId, type])
  @@map("cash_vault_movements")
}

// ===== Módulo 17 — Rotina do Supervisor (Onda 4) =============================
enum VisitStatus {
  PLANNED
  DONE
  CANCELED
}

/// Visita do supervisor a uma unidade (Fase B) + feedback e checklist da visita
/// (Fase C — resultados congelados em JSON: [{ item, ok, note }]).
model SupervisorVisit {
  id               String      @id @default(cuid())
  unitId           String
  supervisorId     String
  supervisorName   String
  scheduledDate    String // 'YYYY-MM-DD'
  status           VisitStatus @default(PLANNED)
  feedback         String?
  checklistId      String?
  checklistName    String?
  checklistResults Json?
  doneAt           DateTime?
  createdAt        DateTime    @default(now())

  @@index([unitId, scheduledDate])
  @@index([supervisorId, status])
  @@map("supervisor_visits")
}

/// Recorrência de visitas (Fase B): 1 plano por unidade — "visitar a cada N
/// dias". Concluir uma visita da unidade reagenda a próxima; vencido → aviso
/// 1×/dia ao supervisor da unidade (espelho do MaintenancePlan).
model SupervisorVisitPlan {
  id             String    @id @default(cuid())
  unitId         String    @unique
  frequencyDays  Int
  active         Boolean   @default(true)
  createdById    String
  createdByName  String
  lastVisitAt    DateTime?
  nextDueAt      DateTime
  lastNotifiedAt DateTime?
  createdAt      DateTime  @default(now())

  @@index([nextDueAt])
  @@map("supervisor_visit_plans")
}

// ===== Integrações RH (v1.16.0) ==============================================
enum RhEventStatus {
  PROCESSED // aplicado no SGO
  RECEIVED // recebido e registrado (processamento futuro)
  ERROR // payload inválido / colaborador não encontrado
}

/// Evento recebido do RH (envio automático RH→SGO): admissões, desligamentos,
/// períodos aquisitivos. Tudo fica registrado (rastreável na central de APIs).
model RhInboundEvent {
  id        String        @id @default(cuid())
  event     String // inclusao | desligamento | periodo_aquisitivo | exclusao_periodo | …
  payload   Json
  status    RhEventStatus
  message   String?
  createdAt DateTime      @default(now())

  @@index([createdAt])
  @@map("rh_inbound_events")
}

/// Aviso ao RH de variação da Escala (Realizado ≠ trabalho normal): registro
/// local + relatório por período; `sent` marca o envio quando a API do RH
/// aceitar este tipo de evento.
model RhScheduleNotice {
  id               String   @id @default(cuid())
  unitId           String
  collaboratorId   String
  collaboratorName String
  date             String // 'YYYY-MM-DD'
  status           String // rótulo lançado no Realizado (F, FI, FJ, A, FE…)
  createdById      String
  createdByName    String
  sent             Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([unitId, date])
  @@index([createdAt])
  @@map("rh_schedule_notices")
}

/// Checklist de supervisor (Fase C) — criado em Configurações, usado na visita.
model SupervisorChecklist {
  id        String   @id @default(cuid())
  name      String
  items     Json // string[]
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("supervisor_checklists")
}

/// Catálogo de produtos-padrão da rede (Módulo 22 / v1.3). Foto de referência
/// usada pela IA para apontar, numa foto da vitrine, produtos FORA do padrão.
model ProductStandard {
  id          String   @id @default(cuid())
  category    String // ex: "Vitrine de bebidas"
  name        String
  description String?
  photoPath   String?
  active      Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())

  @@index([category])
  @@map("product_standards")
}

// ───────────────────────── Desligamentos (Módulo 21 / v1.3) ─────────────────────────
enum NoticeType {
  WORKED // aviso trabalhado
  INDEMNIFIED // aviso indenizado
}

enum TerminationStatus {
  PENDING // aguardando o supervisor
  APPROVED // aprovado (encaminhar ao RH)
  REJECTED // recusado
}

/// Solicitação de desligamento (gerente → supervisor → RH).
model Termination {
  id                  String            @id @default(cuid())
  unitId              String
  collaboratorId      String
  requestedById       String?
  noticeType          NoticeType
  noticeJustification String? // justificativa do tipo de aviso
  reason              String // motivo do desligamento
  // Snapshots no momento da solicitação
  collaboratorName    String
  ageYears            Int?
  tenureText          String?
  certCount           Int               @default(0)
  certDays            Int               @default(0)
  status              TerminationStatus @default(PENDING)
  approvedById        String?
  approvedAt          DateTime?
  rejectionReason     String?
  createdAt           DateTime          @default(now())

  unit         Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  collaborator Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  requestedBy  User?        @relation("TermReqBy", fields: [requestedById], references: [id], onDelete: SetNull)
  approvedBy   User?        @relation("TermApprBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([unitId, status])
  @@map("terminations")
}

model CollaboratorUnit {
  id             String @id @default(cuid())
  collaboratorId String
  unitId         String

  collaborator Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  unit         Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([collaboratorId, unitId])
  @@map("collaborator_units")
}

enum VacationStatus {
  CONFIRMED // confirmada (via RH)
  CHANGE_REQUESTED // alteração solicitada pelo gerente
  APPROVED // aprovada
  REQUESTED // solicitada ao RH pelo gerente (item 11, Onda 3 — provisório até a API do RH)
}

/// Férias (Módulo 9.1). Programação via RH; gerente solicita alteração.
model Vacation {
  id             String         @id @default(cuid())
  collaboratorId String
  unitId         String
  startDate      DateTime
  endDate        DateTime
  status         VacationStatus @default(CONFIRMED)
  changeNote     String?
  createdAt      DateTime       @default(now())

  collaborator Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  unit         Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([unitId])
  @@map("vacations")
}

enum ScheduleVariation {
  NONE
  ABSENCE // falta
  LATE // atraso
  SWAP // troca
}

/// Escala (Módulo 9.2) — importada (somente leitura); gerente registra variações.
model ScheduleEntry {
  id             String            @id @default(cuid())
  collaboratorId String
  unitId         String
  date           DateTime
  planned        String // ex: "18:00-23:00" (planejado, não sobrescrito)
  variation      ScheduleVariation @default(NONE)
  variationNote  String?
  createdAt      DateTime          @default(now())

  collaborator Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  unit         Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([unitId, date])
  @@map("schedule_entries")
}

enum PopStatus {
  DRAFT // Rascunho
  PUBLISHED // Publicado
  ARCHIVED // Arquivado
}

enum PopRecurrence {
  ONCE    // treinamento único
  MONTHLY // reciclagem mensal
}

/// POP (Módulo 10) — blocos em JSON, versionamento e confirmação de leitura.
/// Também serve de TREINAMENTO (Fase POPs-treino): isInitial = todo novo colaborador;
/// sectors = setorial; recurrence = reciclagem. Se não for inicial e sem setores,
/// é apenas POP de referência (não gera treinamento obrigatório).
model Pop {
  id         String        @id @default(cuid())
  title      String
  category   String?
  sector     String? // legado (texto único); novo cadastro usa PopSector
  version    Int           @default(1)
  status     PopStatus     @default(DRAFT)
  isInitial  Boolean       @default(false) // treinamento inicial (toda a unidade)
  recurrence PopRecurrence @default(ONCE)
  /// blocos: [{type:'text'|'image'|'video'|'checklist', ...}]
  content    Json
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  units     PopUnit[]
  reads     PopRead[]
  sectors   PopSector[]
  trainings TrainingRecord[]

  @@map("pops")
}

/// Setor (por NOME) ao qual o POP/treinamento se aplica (vale em todas as unidades do POP).
model PopSector {
  id         String @id @default(cuid())
  popId      String
  sectorName String

  pop Pop @relation(fields: [popId], references: [id], onDelete: Cascade)

  @@unique([popId, sectorName])
  @@map("pop_sectors")
}

enum TrainingStatus {
  PENDING // pendente (no prazo)
  DONE    // realizado
  MISSED  // não realizado (venceu o prazo)
}

/// Registro de treinamento de um colaborador num POP, por período
/// (periodKey = 'INICIAL' para onboarding/setor, ou 'AAAA-MM' para reciclagem mensal).
model TrainingRecord {
  id             String         @id @default(cuid())
  popId          String
  popVersion     Int
  collaboratorId String
  unitId         String
  sectorName     String? // null = treinamento inicial
  periodKey      String
  status         TrainingStatus @default(PENDING)
  dueDate        DateTime
  completedAt    DateTime?
  completedById  String?
  createdAt      DateTime       @default(now())

  pop          Pop          @relation(fields: [popId], references: [id], onDelete: Cascade)
  collaborator Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  unit         Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  completedBy  User?        @relation("TrainingBy", fields: [completedById], references: [id], onDelete: SetNull)

  @@unique([popId, collaboratorId, periodKey])
  @@index([unitId, status])
  @@index([collaboratorId])
  @@map("training_records")
}

/// Configurações simples chave/valor (ex.: peso de Treinamentos na meta).
model AppSetting {
  key   String @id
  value String

  @@map("app_settings")
}

model PopUnit {
  id     String @id @default(cuid())
  popId  String
  unitId String

  pop  Pop  @relation(fields: [popId], references: [id], onDelete: Cascade)
  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([popId, unitId])
  @@map("pop_units")
}

/// Confirmação de leitura de POP (quem, quando, qual versão).
model PopRead {
  id      String   @id @default(cuid())
  popId   String
  userId  String
  version Int
  readAt  DateTime @default(now())

  pop  Pop  @relation(fields: [popId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([popId, userId, version])
  @@map("pop_reads")
}

/// Setor de uma unidade (Mapa de Funções — Módulo 9.3). Definido pelo Admin.
model Sector {
  id        String   @id @default(cuid())
  unitId    String
  name      String
  /// meta de pessoas por turno (para cobertura ✅/⚠️/🔴); 0 = sem meta
  minHeadcount Int   @default(1)
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  unit        Unit                  @relation(fields: [unitId], references: [id], onDelete: Cascade)
  allocations WorkforceAllocation[]
  freelancerRequests PaymentRequest[] @relation("FreelancerSector")

  @@index([unitId])
  @@map("sectors")
}

/// Alocação de colaborador em Setor × Turno/Horário (grade do Mapa de Funções).
/// Origem híbrida: pode vir da escala do RH (collaboratorName) ou alocação manual.
model WorkforceAllocation {
  id             String   @id @default(cuid())
  unitId         String
  sectorId       String
  /// rótulo do turno/horário (ex: "Manhã 06-14", "Noite 18-23")
  shift          String
  collaboratorId String?
  /// nome quando vier do RH sem vínculo local (fallback)
  collaboratorName String?
  /// turno padronizado da unidade (opcional; mantém `shift` como rótulo p/ compat)
  shiftId        String?
  /// 'RH' (escala) ou 'MANUAL' (alocação do gerente/admin)
  source         String   @default("MANUAL")
  createdAt      DateTime @default(now())

  unit         Unit          @relation(fields: [unitId], references: [id], onDelete: Cascade)
  sector       Sector        @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  collaborator Collaborator? @relation(fields: [collaboratorId], references: [id], onDelete: SetNull)
  shiftRef     Shift?        @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  @@index([unitId, sectorId])
  @@map("workforce_allocations")
}

/// Foto do mapa da unidade num DIA (congelada ao fim do dia operacional, Módulo 9.3).
/// Texto denormalizado para o histórico não mudar se o quadro/escala forem editados.
model WorkforceDaySnapshot {
  id         String   @id @default(cuid())
  unitId     String
  date       String // yyyy-mm-dd (dia civil no fuso da unidade)
  sectorName String
  shiftLabel String
  personName String
  kind       String   @default("STAFF") // STAFF | FREELANCER
  createdAt  DateTime @default(now())

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([unitId, date])
  @@map("workforce_day_snapshots")
}

/// Central de Notificações in-app (conceito transversal nº 4). Fonte garantida
/// mesmo se o push (FCM) falhar.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String?
  link      String?
  module    String?
  /// CRITICAL não pode ser desativada; usada p/ destaque
  critical  Boolean  @default(false)
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
  @@map("notifications")
}

// ── Perfis de acesso (Fase C) ──
// Matriz de permissões por perfil × módulo (ver/editar). Perfis continuam fixos
// (enum Role); o Admin ajusta o que cada um pode. Ausência de linha = padrão no código.
model RolePermission {
  id      String  @id @default(cuid())
  role    Role
  module  String  // chave do módulo (ex: 'WASTE', 'PEOPLE', 'SCHEDULE', 'CONFIG'...)
  canView Boolean @default(true)
  canEdit Boolean @default(true)

  @@unique([role, module])
  @@map("role_permissions")
}

// ── Turnos por unidade (Fase B) ──
model Shift {
  id        String   @id @default(cuid())
  unitId    String
  name      String   // ex: "Manhã", "Noite"
  startTime String?  // "06:00"
  endTime   String?  // "14:00"
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  unit              Unit                  @relation(fields: [unitId], references: [id], onDelete: Cascade)
  allocations       WorkforceAllocation[]
  employeeSchedules EmployeeSchedule[]

  @@index([unitId])
  @@map("shifts")
}

// ── Escala (Fase D) ──
// PLANEJADO = gerado do padrão (EmployeeSchedule) + ajustes (SchedulePlanOverride).
// REALIZADO = ScheduleActual (única coisa editável no dia a dia).
enum ScheduleType {
  TWELVE36_ODD  // 12x36 turno ímpar (trabalha dias ímpares do ciclo)
  TWELVE36_EVEN // 12x36 turno par
  SIX_ONE       // 6x1
  FIVE_TWO      // 5x2
  CUSTOM        // padrão livre (customMask)
}

/// Status de um dia: T, F, FI, FJ, A, FE
enum DayStatus {
  WORK         // T  - Trabalho
  OFF          // F  - Folga
  FALTA_INJUST // FI - Falta injustificada
  FALTA_JUST   // FJ - Falta justificada
  ATESTADO     // A  - Atestado
  FERIAS       // FE - Férias
  ATRASO       // AT - Atraso (trabalhou, chegou atrasado — avisa o RH p/ conferência de ponto)
}

/// Cadastro do padrão de escala do colaborador (gera o Planejado).
model EmployeeSchedule {
  id             String       @id @default(cuid())
  collaboratorId String
  unitId         String
  scheduleType   ScheduleType
  anchorDate     DateTime     // início do ciclo (referência p/ gerar o padrão)
  shiftId        String?
  customMask     String?      // p/ CUSTOM: ciclo em T/F, ex "TTTTTFF"
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  collaborator Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  unit         Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  shift        Shift?       @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  @@unique([collaboratorId, unitId])
  @@map("employee_schedules")
}

/// Ajuste manual pontual do PLANEJADO (sobrescreve o gerado por dia).
model SchedulePlanOverride {
  id             String    @id @default(cuid())
  collaboratorId String
  unitId         String
  date           DateTime
  status         DayStatus // normalmente WORK/OFF
  createdAt      DateTime  @default(now())

  collaborator Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  unit         Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([collaboratorId, date])
  @@index([unitId, date])
  @@map("schedule_plan_overrides")
}

/// REALIZADO — o que de fato aconteceu (única aba editável pelo gerente).
model ScheduleActual {
  id             String    @id @default(cuid())
  collaboratorId String
  unitId         String
  date           DateTime
  status         DayStatus
  note           String?
  reason         String?   // motivo (ausência)
  attachmentPath String?   // atestado/anexo
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  collaborator Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  unit         Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("ScheduleActualBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([collaboratorId, date])
  @@index([unitId, date])
  @@map("schedule_actuals")
}

// ───────────────────────── Central de Comunicação (Módulo 15) ─────────────────────────
enum CommunicationPriority {
  NORMAL
  IMPORTANT
  URGENT
}

enum CommRecipientStatus {
  PENDING
  CONFIRMED
}

/// Comunicado da supervisão/admin para gerentes (confirmação obrigatória + meta).
model Communication {
  id               String                @id @default(cuid())
  authorId         String?
  title            String
  body             String
  priority         CommunicationPriority @default(NORMAL)
  pinned           Boolean               @default(false)
  /// Exige que o gerente anexe foto/comentário ao confirmar (prova de execução)
  requiresResponse Boolean               @default(false)
  /// Links clicáveis: array de { label, url }
  links            Json?
  /// Prazo de confirmação (define pontual/atrasado/não lido na meta)
  dueAt            DateTime
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  author      User?                     @relation("CommAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  units       CommunicationUnit[]
  attachments CommunicationAttachment[]
  recipients  CommunicationRecipient[]

  @@index([createdAt])
  @@map("communications")
}

/// Unidades-alvo do comunicado (todos os gerentes destas unidades confirmam).
model CommunicationUnit {
  id              String @id @default(cuid())
  communicationId String
  unitId          String

  communication Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)
  unit          Unit          @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([communicationId, unitId])
  @@map("communication_units")
}

/// Anexo (foto/PDF) do comunicado.
model CommunicationAttachment {
  id              String  @id @default(cuid())
  communicationId String
  path            String
  mimeType        String
  name            String?

  communication Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)

  @@map("communication_attachments")
}

/// Destinatário (snapshot) que precisa confirmar — base do painel e da meta.
model CommunicationRecipient {
  id              String              @id @default(cuid())
  communicationId String
  userId          String
  /// Unidade de atribuição (para a meta). Null = avulso sem unidade.
  unitId          String?
  status          CommRecipientStatus @default(PENDING)
  confirmedAt     DateTime?
  /// true quando confirmou após o prazo (neutro na meta)
  late            Boolean             @default(false)
  responseNote    String?
  responsePath    String?
  createdAt       DateTime            @default(now())

  communication Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)
  user          User          @relation("CommRecipient", fields: [userId], references: [id], onDelete: Cascade)
  unit          Unit?         @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@unique([communicationId, userId])
  @@index([userId, status])
  @@index([unitId])
  @@map("communication_recipients")
}

// ───────────────────────── Fornecedores (lista compartilhada) ─────────────────────────
/// Cadastro de fornecedores compartilhado: Gás, Notas Recebidas e Pagamentos.
/// Alimentado por Admin/Supervisor. Comparações por fornecedor dependem deste registro.
model Supplier {
  id          String   @id @default(cuid())
  name        String
  cnpj        String?
  pixKey      String?
  /// Categoria livre (ex.: Gás, Carnes, Bebidas, Hortifruti)
  category    String?
  notes       String?
  active      Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy       User?            @relation("SupplierBy", fields: [createdById], references: [id], onDelete: SetNull)
  gasReceipts     GasReceipt[]
  receivedNotes   ReceivedNote[]
  paymentRequests PaymentRequest[]
  oilCollections  OilCollection[]
  inventoryItems  InventoryItem[]

  @@index([active])
  @@map("suppliers")
}

// ───────────────────────── Recebimento de Gás (Módulo 16) ─────────────────────────
/// Recebimento de gás (granel, em kg). preço/kg = valor total ÷ kg. Acompanhamento
/// de preço por unidade e por fornecedor, com alerta de variação.
/// Forma de recebimento do gás: granel (kg) ou botijão (ex.: P45).
enum GasKind {
  BULK // granel (kg)
  CYLINDER // botijão (P13/P20/P45…)
}

/// Contrato de gás por UNIDADE+FORNECEDOR (16/07): período, quantidade (kg) e
/// preço/kg acordados. A baixa vem dos recebimentos lançados; initialUsedKg é a
/// posição de contrato que já estava em andamento antes do SGO.
model GasContract {
  id            String   @id @default(cuid())
  unitId        String
  supplierId    String
  startDate     String // YYYY-MM-DD
  endDate       String
  quantityKg    Decimal  @db.Decimal(12, 2)
  pricePerKg    Decimal  @db.Decimal(10, 4)
  initialUsedKg Decimal  @db.Decimal(12, 2) @default(0)
  active        Boolean  @default(true)
  note          String?
  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())

  @@index([unitId, active])
  @@index([supplierId])
  @@map("gas_contracts")
}

model GasReceipt {
  id              String   @id @default(cuid())
  unitId          String
  supplierId      String?
  /// Dia operacional do recebimento (YYYY-MM-DD)
  operationalDate String
  /// Edição de data por Admin/Supervisor (item 4) — penaliza a meta do gerente
  dateEdited       Boolean @default(false)
  dateEditedByName String?
  accessKey       String?
  noteNumber      String?
  /// Forma de recebimento. Botijão converte para kg (count × cylinderKg) p/ os dashboards.
  kind             GasKind @default(BULK)
  cylinderCount    Int? // botijões recebidos
  cylinderKg       Int? // kg por botijão (P45 = 45)
  cylindersReturned Int? // botijões vazios devolvidos (troca)
  quantityKg      Decimal  @db.Decimal(10, 2)
  totalValue      Decimal  @db.Decimal(12, 2)
  /// Snapshot do preço por kg (valor total ÷ kg)
  pricePerKg      Decimal  @db.Decimal(10, 4)
  /// Preço/kg da compra anterior (mesma unidade) para a variação
  prevPricePerKg  Decimal? @db.Decimal(10, 4)
  variationPct    Float?
  alerted         Boolean  @default(false)
  observation     String?
  createdById     String?
  createdAt       DateTime @default(now())

  unit      Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  supplier  Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdBy User?     @relation("GasReceiptBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([unitId, operationalDate])
  @@index([supplierId])
  @@map("gas_receipts")
}

// ───────────────────────── Coleta de Óleo (Módulo 17) ─────────────────────────
/// Coleta de óleo usado (resto de fritura). Recebemos por ela — controle de
/// litros, valor/litro, valor total e forma de recebimento, com histórico.
model OilCollection {
  id              String   @id @default(cuid())
  unitId          String
  supplierId      String?
  operationalDate String
  /// Edição de data por Admin/Supervisor (item 4) — penaliza a meta do gerente
  dateEdited       Boolean @default(false)
  dateEditedByName String?
  liters          Decimal  @db.Decimal(10, 2)
  pricePerLiter   Decimal  @db.Decimal(10, 4)
  totalValue      Decimal  @db.Decimal(12, 2)
  /// Como recebemos: PIX, Dinheiro, Crédito, Troca por produto, etc.
  paymentMethod   String?
  collectorName   String?
  observation     String?
  createdById     String?
  createdAt       DateTime @default(now())

  unit      Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  supplier  Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdBy User?     @relation("OilBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([unitId, operationalDate])
  @@map("oil_collections")
}

// ───────────────────────── Central de Atestados (Módulo 19) ─────────────────────────
enum CertificateType {
  FULL_DAY // dias inteiros de afastamento
  HOURS // atestado de horas (consulta) — não afasta o dia todo
  COMPANION // acompanhamento de familiar (declaração de comparecimento)
}

/// Atestado médico de colaborador (Módulo 19). Captura por foto + leitura por IA,
/// análise por unidade. CID é dado sensível (LGPD): exibir só p/ ADMIN/CEO/RH.
model MedicalCertificate {
  id             String          @id @default(cuid())
  unitId         String
  collaboratorId String
  type           CertificateType @default(FULL_DAY)
  /// Datas em yyyy-mm-dd (dia civil; afastamento usa o calendário, regra nº 5)
  issueDate      String?
  startDate      String
  endDate        String
  /// Dias de afastamento (inclusivo). Para HOURS normalmente 1 e usa `hours`.
  days           Int             @default(1)
  hours          Decimal?        @db.Decimal(5, 2)
  doctorName     String?
  doctorCrm      String?
  /// CID — DADO SENSÍVEL (LGPD). Nunca expor a gerentes nem em dashboards.
  cid            String?
  /// Descrição do CID (o que o código significa) — também sensível, só ADMIN/CEO/RH.
  cidDescription String?
  attachmentPath String?
  /// Espelho do que a IA leu (campos + confiança), só para referência/auditoria.
  aiExtracted    Json?
  observation    String?
  createdById    String?
  createdAt      DateTime        @default(now())

  unit         Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  collaborator Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("CertBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([unitId, startDate])
  @@index([collaboratorId, startDate])
  @@map("medical_certificates")
}

// ───────────────────────── Inventário de Equipamentos (Módulo 18) ─────────────────────────
enum InventoryMovementType {
  IN // recebimento/entrada
  OUT // saída
  ADJUST // contagem/ajuste
}

/// Item de estoque de equipamentos do restaurante (fora do Teknisa).
model InventoryItem {
  id          String   @id @default(cuid())
  unitId      String
  name        String
  supplierId  String?
  category    String?
  /// Unidade de medida exibida (un, cx, kg, L...)
  unitLabel   String   @default("un")
  unitValue   Decimal  @db.Decimal(12, 2) @default(0)
  currentQty  Decimal  @db.Decimal(12, 2) @default(0)
  minQty      Decimal? @db.Decimal(12, 2)
  location    String?
  active      Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  unit      Unit                @relation(fields: [unitId], references: [id], onDelete: Cascade)
  supplier  Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdBy User?               @relation("InvItemBy", fields: [createdById], references: [id], onDelete: SetNull)
  movements InventoryMovement[]

  @@index([unitId, active])
  @@map("inventory_items")
}

/// Movimentação de estoque (entrada/saída/ajuste) — atualiza currentQty do item.
model InventoryMovement {
  id              String                @id @default(cuid())
  itemId          String
  unitId          String
  type            InventoryMovementType
  qty             Decimal               @db.Decimal(12, 2)
  /// Saldo do item após o movimento (snapshot p/ histórico)
  balanceAfter    Decimal               @db.Decimal(12, 2)
  unitValue       Decimal?              @db.Decimal(12, 2)
  note            String?
  operationalDate String
  createdById     String?
  createdAt       DateTime              @default(now())

  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  unit      Unit          @relation(fields: [unitId], references: [id], onDelete: Cascade)
  createdBy User?         @relation("InvMoveBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([itemId, createdAt])
  @@index([unitId, operationalDate])
  @@map("inventory_movements")
}

// ───────────────────────── Modelos de checklist (biblioteca editável) ─────────────────────────
/// Biblioteca de modelos prontos de checklist (Admin cria/edita/exclui). A partir
/// de um modelo, o Admin gera checklists (TaskTemplate) nas unidades.
model ChecklistModel {
  id               String              @id @default(cuid())
  name             String
  category         String?             // setor (ex.: Cozinha, Churrasco, Salão)
  moment           String?             // Abertura, Durante o turno, Fechamento…
  scope            ChecklistScope      @default(UNIT)
  limitTime        String?
  weight           Int                 @default(10)
  requiresEvidence Boolean             @default(false)
  active           Boolean             @default(true)
  order            Int                 @default(0)
  /// veio do seed padrão (apenas marca a origem)
  builtin          Boolean             @default(false)
  createdById      String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  createdBy User?                 @relation("ChecklistModelBy", fields: [createdById], references: [id], onDelete: SetNull)
  items     ChecklistModelItem[]

  @@index([active, order])
  @@map("checklist_models")
}

model ChecklistModelItem {
  id            String  @id @default(cuid())
  modelId       String
  section       String?
  text          String
  requiresPhoto Boolean @default(false)
  order         Int     @default(0)

  model ChecklistModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@index([modelId])
  @@map("checklist_model_items")
}

// ===== Módulo 6.1 — Manutenção (chamados + preventiva) =======================
enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELED
}

// Chamado de manutenção (reativo). Pode nascer de uma ocorrência de manutenção.
// Campos denormalizados (equipamento/fornecedor/pessoas) no padrão snapshot.
model MaintenanceTicket {
  id             String            @id @default(cuid())
  unitId         String
  number         Int
  title          String
  description    String?
  equipmentId    String?
  equipmentName  String?
  supplierId     String?
  supplierName   String?
  status         MaintenanceStatus @default(OPEN)
  cost           Decimal?          @db.Decimal(12, 2)
  deadline       DateTime?
  occurrenceId   String?
  planId         String?
  openedById     String?
  openedByName   String?
  doneById       String?
  doneByName     String?
  doneAt         DateTime?
  resolutionNote String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([unitId, status])
  @@map("maintenance_tickets")
}

// Plano de manutenção preventiva por equipamento (recorrência em dias).
model MaintenancePlan {
  id            String   @id @default(cuid())
  unitId        String
  title         String
  description   String?
  equipmentId   String?
  equipmentName String?
  frequencyDays Int
  nextDueAt     DateTime
  lastDoneAt    DateTime?
  lastNotifiedAt DateTime?
  active        Boolean  @default(true)
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  logs MaintenancePlanLog[]

  @@index([unitId, active])
  @@map("maintenance_plans")
}

// Histórico de execuções de um plano preventivo.
model MaintenancePlanLog {
  id         String   @id @default(cuid())
  planId     String
  doneAt     DateTime @default(now())
  doneById   String?
  doneByName String?
  note       String?

  plan MaintenancePlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@map("maintenance_plan_logs")
}
